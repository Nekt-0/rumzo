# Optional: a GitHub token with read access to public repository metadata.
# Set environment variables in your shell, or use Node's --env-file option.
# Never paste tokens into the web form, reports, or Git history.
GITHUB_TOKEN=
# Optional: use a Robinhood Chain mainnet provider for reliable RPC capacity.
RUMZO_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Local snapshots. The server binds to 127.0.0.1 only.
RUMZO_DATA_DIR=.rumzo
# Optional: alerts from the local `watch start` runner. Never expose these in browser code.
RUMZO_TELEGRAM_BOT_TOKEN=
RUMZO_TELEGRAM_CHAT_ID=
PORT=4317
